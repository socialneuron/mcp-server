{
  "name": "@socialneuron/mcp-server",
  "display_name": "Social Neuron",
  "description": "91 public MCP tools in the npm package for creating, scheduling, and analyzing social content. The separately versioned hosted service exposes 92 public tools, including project-scoped Content Calendar and Analytics Pulse MCP Apps.",
  "version": "2.1.1",
  "homepage": "https://socialneuron.com/for-developers",
  "repository": "https://github.com/socialneuron/mcp-server",
  "license": "MIT",
  "icon": "https://socialneuron.com/icon-512.png",
  "icons": [
    {
      "src": "https://socialneuron.com/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ],
      "theme": "light"
    },
    {
      "src": "https://socialneuron.com/icon-192.png",
      "mimeType": "image/png",
      "sizes": [
        "192x192"
      ],
      "theme": "light"
    },
    {
      "src": "https://socialneuron.com/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "terms_of_service": "https://socialneuron.com/terms",
  "privacy_policy": "https://socialneuron.com/privacy",
  "author": {
    "name": "Social Neuron",
    "url": "https://socialneuron.com"
  },
  "categories": [
    "social-media",
    "content-creation",
    "analytics",
    "marketing",
    "automation"
  ],
  "tools_count": 91,
  "transport": [
    "stdio",
    "http"
  ],
  "http_endpoint": "https://mcp.socialneuron.com/mcp",
  "install": {
    "command": "npx",
    "args": [
      "-y",
      "@socialneuron/mcp-server"
    ]
  },
  "auth": {
    "type": "oauth2_and_api_key",
    "setup_url": "https://socialneuron.com/settings/developer",
    "docs_url": "https://socialneuron.com/for-developers",
    "oauth": {
      "authorization_endpoint": "https://mcp.socialneuron.com/authorize",
      "token_endpoint": "https://mcp.socialneuron.com/token",
      "registration_endpoint": "https://mcp.socialneuron.com/register",
      "metadata_url": "https://mcp.socialneuron.com/.well-known/oauth-authorization-server",
      "scopes_supported": [
        "mcp:full",
        "mcp:read",
        "mcp:write",
        "mcp:distribute",
        "mcp:analytics",
        "mcp:comments",
        "mcp:autopilot"
      ],
      "code_challenge_methods_supported": [
        "S256"
      ]
    }
  },
  "pricing": {
    "has_free_tier": true,
    "free_tier_note": "50 credits/mo (no MCP access). MCP/API requires Pro ($49/mo) or higher; the 14-day trial includes Read, Write, Distribute, and Analytics scopes.",
    "starting_price": "$19/mo",
    "pricing_url": "https://socialneuron.com/pricing"
  },
